{
  "_comment": "Паттерны обезличивания. (?!\\*\\*\\*) = не матчить, если значение уже ***. IgnoreCase + Multiline применяются в скрипте.",
  "patterns": [
    "\\d{8,12}:[A-Za-z0-9_-]{30,40}",
    "ghp_[A-Za-z0-9]{36}",
    "gho_[A-Za-z0-9]{36}",
    "ghu_[A-Za-z0-9]{36}",
    "ghs_[A-Za-z0-9]{36}",
    "xox[baprs]-[A-Za-z0-9-]+",
    "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
    "AKIA[0-9A-Z]{16}",
    "sk-[A-Za-z0-9]{40,}",
    "AIza[0-9A-Za-z_-]{35}",
    "pwd[-._]?\\w+\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "password\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "passwd\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "pass\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "api[_-]?key\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "token\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "secret\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "user\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "username\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "login\\s*[:=]\\s*(?!\\*\\*\\*)\\S+",
    "\"(password|passwd|pass|token|secret|api_?key)\"\\s*:\\s*\"(?!\\*\\*\\*)[^\"]+\"",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]+?-----END [A-Z ]*PRIVATE KEY-----",
    "\\b[A-Za-z0-9+/]{40,}={0,2}\\b",
    "\\b[a-fA-F0-9]{32,}\\b",
    "://(?!\\*\\*\\*)[^:/@\\s]+:(?!\\*\\*\\*)[^@/\\s]+@",
    "^\\s*#\\s*(?=[A-Za-z0-9!@$%^&*+=\\-\\.\\/]*[a-z])(?=[A-Za-z0-9!@$%^&*+=\\-\\.\\/]*[A-Z])(?=[A-Za-z0-9!@$%^&*+=\\-\\.\\/]*[0-9])[A-Za-z0-9!@$%^&*+=\\-\\.\\/]{20,}\\s*$"
  ]
}